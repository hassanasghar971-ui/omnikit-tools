# ─────────────────────────────────────────────────────────────────────
# OmniKit Tools — environment configuration
# EVERY VARIABLE IS OPTIONAL. The app deploys to Vercel with ZERO
# configuration — no keys are required to build or run.
# ─────────────────────────────────────────────────────────────────────

# ── Canonical domain override (OPTIONAL) ────────────────────────────
# On Vercel, the canonical URL is auto-detected from the built-in
# VERCEL_URL system variable — you never need to set this. Set it only
# if you use a custom domain and want canonicals to match it exactly.
NEXT_PUBLIC_SITE_URL=https://omnikit.tools

# ── Google AdSense (OPTIONAL — both required to activate ad slots) ──
# Until these are set, fixed-size branded placeholders render instead
# (CLS stays 0 either way, so the site looks perfect without them).
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_AD_SLOT=1234567890

# ── PostgreSQL (OPTIONAL — powers the contact inbox only) ───────────
# Leave unset on Vercel: the contact form degrades gracefully and
# the health endpoint stays green in pure static mode.
DATABASE_URL=postgresql://user:password@host:5432/omnikit
